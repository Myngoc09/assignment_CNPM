# Copy this file to .env and fill in your own local development values.
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/brewlite
DB_SYNCHRONIZE=true
JWT_SECRET=replace-with-a-long-random-secret

# Email settings (optional for local development)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=

FRONTEND_URL=http://localhost:3000

# Mock Bank - keep the existing Task 8 provider
MOCK_BANK_URL=http://localhost:4000
MOCK_BANK_API_KEY=your-mock-bank-api-key
MOCK_BANK_SECRET=your-mock-bank-secret
MOCK_PAYMENT_RESULT=SUCCESS

# VNPay Sandbox - TmnCode / HashSecret lấy trong email VNPay gửi khi đăng ký sandbox.
# KHÔNG commit file .env chứa HashSecret thật.
VNPAY_TMN_CODE=YOUR_SANDBOX_TMN_CODE
VNPAY_HASH_SECRET=YOUR_SANDBOX_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL VNPay chuyển TRÌNH DUYỆT của người thanh toán về sau khi trả tiền.
# - Thanh toán ngay trên máy chạy backend:   http://localhost:3001/payments/vnpay/return
# - Quét QR bằng điện thoại (cùng Wi-Fi):    http://<IP-LAN-của-máy>:3001/payments/vnpay/return
# - Khác mạng / muốn nhận IPN thật:          https://<ngrok>/payments/vnpay/return
# (localhost trên điện thoại là chính điện thoại, không về được backend của bạn)
VNPAY_RETURN_URL=http://localhost:3001/payments/vnpay/return

# (Tùy chọn) Trang kết quả ở frontend. Nếu đặt, Return URL sẽ redirect về đó kèm
# ?status=...&orderId=...&paymentId=...; để trống thì trả JSON.
VNPAY_RESULT_REDIRECT_URL=

# (Tùy chọn) Số phút giao dịch/QR còn hiệu lực. Mặc định 15.
VNPAY_EXPIRE_MINUTES=15

# (Chỉ để ghi nhớ) IPN URL được khai báo trong trang quản trị merchant của VNPay,
# backend KHÔNG đọc biến này. Cần địa chỉ công khai: https://<ngrok>/payments/vnpay/ipn
# VNPAY_IPN_URL=https://YOUR-PUBLIC-BACKEND/payments/vnpay/ipn

# ---------- Chạy công khai (ngrok / Vercel / đám mây) ----------
# (Tùy chọn) Chỉ cho các origin này gọi API; cách nhau bằng dấu phẩy, hỗ trợ
# https://*.vercel.app cho các bản preview. Để trống = cho phép tất cả.
CORS_ORIGINS=https://brewlite-frontend-sand.vercel.app,http://localhost:3000

# (Tùy chọn) Database đám mây yêu cầu SSL (Neon, Supabase, Render, Railway...).
DB_SSL=false
# (Tùy chọn) Tự đồng bộ schema khi khởi động. Mặc định true.
DB_SYNCHRONIZE=true
